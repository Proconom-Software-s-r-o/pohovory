{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "es2023",
        "lib": ["es2023"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true
    },
    "include": ["vite.config.mts"]
}
